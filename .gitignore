# Python cache
__pycache__/
*.py[cod]

# Virtual environments
.venv/
.env

# Coverage reports
.coverage

# IDE / editor files
.vscode/

# Secrets / credentials
config/.secrets/*
config/.credentials/*

# Data / logs / legacy files
data/
logs/*
legacy/
notebooks/

# Selections (ignore everything except dev.yml)
config/selections/*
!config/selections/dev.yml

# Gitkeep files
!.gitkeep

# Distribution / build files
dist/

# Tests data
tests/mock_data/
# Working notes between Jolan and Claude — task lists, briefs, one-off repro
# scripts. These are scratch, not project documentation: they must never end up
# in the history.
ROADMAP.md
MORNING_BRIEF.md
OVERNIGHT_NOTES.md
repro_*.py
